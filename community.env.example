# Community Edition is selected at build time by Next.js.
NEXT_PUBLIC_STOREOPS_EDITION=community
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables the bounded AI policy assistant on your own deployment.
# Core deterministic pricing strategies work without it.
GEMINI_API_KEY=

# Do not configure Clerk, Neon, or Lemon Squeezy for a local Community build.

# Canonical production URL used by SEO metadata and structured data.
NEXT_PUBLIC_SITE_URL=https://www.storeops.dev

# Clerk account authentication. Both keys must come from the same Clerk
# instance. Use live keys in Vercel Production and test keys in Preview.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# Neon/Postgres connection used for users, entitlements, usage, and snapshots.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Gemini powers the bounded AI policy assistant. It never generates the final
# territory price grid.
GEMINI_API_KEY=replace_me

# Lemon Squeezy webhook signing secret. Configure the production webhook URL as
# https://www.storeops.dev/api/webhooks/lemonsqueezy
# Lemon Squeezy accepts 6-40 characters. Use a random 40-character value.
LEMONSQUEEZY_WEBHOOK_SECRET=replace_with_40_random_characters

# Lemon Squeezy checkout URLs shown in the product.
NEXT_PUBLIC_LS_CHECKOUT_URL=https://smoothcode97.lemonsqueezy.com/checkout/buy/82b21e13-323b-4b89-8c15-f84db286ce8b
NEXT_PUBLIC_LS_LIFETIME_CHECKOUT_URL=https://smoothcode97.lemonsqueezy.com/checkout/buy/6db2e564-61aa-48ad-97cc-66943e19c845
NEXT_PUBLIC_LS_CUSTOMER_PORTAL_URL=https://app.lemonsqueezy.com/my-orders

# Displayed prices. Keep these exactly aligned with the checkout products.
NEXT_PUBLIC_YEARLY_PRICE=\$49.99
NEXT_PUBLIC_LIFETIME_PRICE=\$129
NEXT_PUBLIC_LIFETIME_FULL_PRICE=\$129

# Signs 24-hour write proofs for existing license-key customers. Generate an
# independent random secret of at least 32 bytes.
STOREOPS_LICENSE_PROOF_SECRET=replace_with_an_independent_random_secret

# Comma-separated Lemon Squeezy variant IDs. ALLOWED contains every paid legacy
# license variant; PRO and LIFETIME drive account webhook entitlements.
LEMONSQUEEZY_ALLOWED_VARIANT_IDS=1888145,1892544
LEMONSQUEEZY_PRO_VARIANT_IDS=1888145
LEMONSQUEEZY_LIFETIME_VARIANT_IDS=1892544

# Local/self-hosted development only. Omit this from Vercel, or keep it false.
STOREOPS_ALLOW_UNLICENSED_WRITES=false
